{
  "name": "birdhaus-store",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:purs && concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build:purs": "node scripts/spago-local-cache.mjs build",
    "build": "npm run build:purs && vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@stripe/stripe-js": "^7.9.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "stripe": "^18.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "purescript": "^0.15.15",
    "spago": "^1.0.3",
    "vite": "^7.0.6"
  }
}
